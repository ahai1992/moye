{
  "name": "moye-markdown",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "墨页 — 本地 Markdown 编辑器",
  "scripts": {
    "dev": "node node_modules/@tauri-apps/cli/tauri.js dev",
    "dev:ui": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "build": "npm run typecheck && node node_modules/vite/bin/vite.js build",
    "desktop:build": "node node_modules/@tauri-apps/cli/tauri.js build",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:browser": "node tools/browser-check.mjs",
    "test:desktop": "node tools/desktop-check.mjs",
    "test:recovery": "node tools/recovery-check.mjs",
    "deps:local": "node tools/use-local-deps.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language": "6.12.3",
    "@codemirror/search": "6.7.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.0",
    "dompurify": "3.4.5",
    "highlight.js": "11.11.1",
    "katex": "0.16.47",
    "marked": "18.0.4",
    "mermaid": "11.15.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/katex": "0.16.8",
    "@types/node": "25.9.0",
    "@types/turndown": "5.0.6",
    "happy-dom": "20.9.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "4.1.6"
  },
  "engines": { "node": ">=22.12" }
}
